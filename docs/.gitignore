# =========================================
# .gitignore - Canviem la mirada
# =========================================

# --- Secrets i configuració local (MAI pujar-los) ---
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
config.local.*

# --- Sistema operatiu ---
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
*.lnk

# --- Editors i IDEs ---
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# --- Node.js (si s'utilitza npm / bundlers) ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.yarn/
.pnpm-store/

# --- Resultats de compilació ---
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.vite/

# --- PHP (si el backend és PHP) ---
vendor/
composer.phar

# --- Python (si el backend és Python) ---
__pycache__/
*.py[cod]
venv/
.venv/

# --- Bases de dades locals ---
*.sqlite
*.sqlite3
*.db
*.sql.bak

# --- Logs i temporals ---
*.log
logs/
tmp/
temp/
*.tmp
*.bak

# --- Proves i cobertura ---
coverage/
.nyc_output/

# --- Fitxers pujats pels usuaris ---
uploads/

# --- Còpies comprimides (evitar pujar entregues dins del repo) ---
*.zip
*.rar
*.7z
*.tar.gz
